(label "GND" (at 398.7800 127.0000 0) (effects (font (size 1.016 1.016)) (justify left bottom)) (uuid "81bd7f24-ecd3-5ea6-80e8-09a8f39713ca"))
(text "01 / PROTECTED DC POWER PATHS" (at 12.7 15.24 0) (effects (font (size 2 2)) (justify left)) (uuid "e3e26476-ccd3-5024-ab78-5ec794176c1f"))
(text "BAT -> R1 -> SYS -> R2 -> BUCK. Charger -> R3 -> SYS. All returns use protected pack P-." (at 12.7 21.59 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "9436a9d5-c6e4-505f-9ea3-d9e12c2caf60"))
(text "J1 requires a DC fuse near the battery AND a manual disconnect. J2: one matched charger only, <= 1 A; never connect a raw solar panel." (at 12.7 55.88 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "3fd62a9d-054e-5575-b892-470b5c596466"))
(text "02 / THREE 3.3 V CURRENT MONITORS - SOIC PINOUT" (at 12.7 63.5 0) (effects (font (size 2 2)) (justify left)) (uuid "9a4092ba-d1be-530d-a5c8-12c4e36201d8"))
(text "U1 0x40 battery / U2 0x41 buck input / U3 0x44 charger output. R1-R3 0.1 ohm, 1 W. Separate sense takeoffs at shunt pads." (at 12.7 103 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "f8ff4434-8e66-58c2-b758-364a6dfe5471"))
(text "03 / ESP32 SIGNAL HARNESS, TEMPERATURE AND LOCAL BUTTONS" (at 12.7 113.03 0) (effects (font (size 2 2)) (justify left)) (uuid "d71b8e57-83df-564b-9af3-f41a4516af22"))
(text "J7 pins: 1=3V3, 2=GND, 3=GPIO21, 4=GPIO22, 5=GPIO25, 6=GPIO4, 7=GPIO27, 8=GPIO26. Keep cable <= 100 mm." (at 12.7 170.18 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "0ede9f4e-3057-51e9-9020-9cf297b278a7"))
(text "04 / FUSED 5 V LOADS AND DEFAULT-OFF FAN SWITCH" (at 12.7 177.8 0) (effects (font (size 2 2)) (justify left)) (uuid "6ca61e29-42d8-5077-9029-03c7a359888a"))
(text "Q1 low-side switches a power-only fan. No secondary fan ground/data connection." (at 12.7 241.3 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "f27699ae-132e-5b5b-999d-7b971db2d598"))
(text "JP1 OPEN for USB. Fit only with USB VBUS absent. J11 is optional ESP32 power, not 3.3 V." (at 12.7 248.92 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "06188dbb-50b4-5dc5-b5ab-9a2f8817f567"))
(text "TARGET: 2 A battery path. 5 V continuous <= 1.5 A total; lamp and fan <= 0.6 A each. Include ESP32 consumption." (at 12.7 261.62 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "90ea11c6-a168-5e5d-8ca4-0b085b0f4462"))
(text "Prototype fabrication package: ERC/DRC are design checks; calibration, thermal and fault tests remain required." (at 12.7 269.24 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "40554940-5a23-5de6-b73a-e4ff86a2b795"))
(embedded_fonts no))